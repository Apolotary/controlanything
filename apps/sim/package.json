{
  "name": "@ce/sim",
  "version": "0.1.0",
  "private": true,
  "description": "ControlAnything sim room: a photo-real virtual ceiling light, virtual IR remote and Web Audio synth that pair over /ws like real devices, so the whole demo runs without hardware.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --emptyOutDir",
    "dev:hmr": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "pack:room": "tsx scripts/pack-room.ts",
    "sam:check": "tsx scripts/sam-check.ts"
  },
  "dependencies": {
    "@ce/protocol": "*",
    "@ce/vsynth": "*",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "vite": "^8.3.5"
  }
}
