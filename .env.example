# Copy to .env (repo root). The server reads it at startup; it never reaches the browser.

# Meta Model API key (https://dev.meta.ai). Leave empty for FIXTURE mode (no network, canned replies labelled FIXTURE).
MODEL_API_KEY=
# Chat/vision model id
MUSE_MODEL=muse-spark-1.3
# API base URL (default https://api.meta.ai/v1); used for chat/completions and asr/transcribe
MUSE_API_BASE=
# reasoning_effort default for chat calls: minimal | low | medium | high | xhigh | max. Empty = model decides.
MUSE_REASONING_EFFORT=
# Muse Voice Transcribe model id
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Force a mode: live | fixture. Empty = live when MODEL_API_KEY is set, else fixture.
MODEL_MODE=
# Simulated latency for fixture replies, in ms
FIXTURE_DELAY_MS=300

# HTTPS + WSS for browsers on the LAN (Quest, phones); self-signed cert generated into apps/server/.certs on first run
HTTPS_HOST=0.0.0.0
HTTPS_PORT=8443
# Plain HTTP + WS: localhost, `adb reverse tcp:8787 tcp:8787`, and LAN clients without TLS (ESP32, CLI).
# Token-authenticated but unencrypted: trusted LAN only. Use HTTP_HOST=127.0.0.1 to keep it local.
HTTP_HOST=0.0.0.0
HTTP_PORT=8787
# Host/IP for QR codes and join URLs. Empty = first LAN IPv4 address.
PUBLIC_HOST=

# Pairing
# 1 = approve the first device automatically while no device is paired (dev convenience)
CE_TRUST_FIRST_DEVICE=
# 0 = do not treat requests from 127.0.0.1/::1 as the owner
CE_TRUST_LOOPBACK=
# 0 = do not read y/n approvals from the server terminal
CE_CONSOLE_APPROVE=

# Recorded real responses (apps/server/fixtures/recorded, committed so the demo runs without a key)
# 1 = in live mode, save every keyed response (chatJson name / fixture / label) for later replay
MUSE_RECORD=
# 0 = in fixture mode, ignore recordings and use only the canned FIXTURE replies
MUSE_REPLAY=
# override the recordings folder
MUSE_RECORD_DIR=

# Brain (the discovery loop)
# SAM 3.1 concept prompts run on every scan frame (device nouns only; never people). Comma-separated.
CE_SCAN_PROMPTS=
# 1 = always learn IR codes from the remote (an IR receiver on the Cardputer or the sim); default: only for unknown/Koizumi lights
CE_IR_LEARN=
# 0 = disable the in-process Mac executor (osascript volume / Music / say), registered as device "mac-local"
CE_MAC_LOCAL=
