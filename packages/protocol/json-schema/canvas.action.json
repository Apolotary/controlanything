{
  "title": "canvas.action",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "canvas.action"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "string",
          "enum": [
            "play",
            "choose",
            "next",
            "restart"
          ]
        },
        "roundId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "choiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      "required": [
        "requestId",
        "cardId",
        "revision",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
