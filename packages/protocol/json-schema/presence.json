{
  "title": "presence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "presence"
    },
    "payload": {
      "type": "object",
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "devices": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "kind": {
                "type": "string",
                "enum": [
                  "quest",
                  "mac",
                  "iphone",
                  "devterm",
                  "cardputer",
                  "web",
                  "sim",
                  "remo"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "hmd",
                  "companion",
                  "controller",
                  "device"
                ]
              },
              "capabilities": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "midi",
                    "serial",
                    "ble",
                    "ir",
                    "camera",
                    "mic",
                    "hands",
                    "display",
                    "speaker",
                    "gpio",
                    "wifi",
                    "local",
                    "printer"
                  ]
                }
              },
              "ports": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "midi-in",
                        "midi-out",
                        "serial",
                        "ble",
                        "ir",
                        "usb"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "manufacturer": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "connected",
                        "disconnected"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "app": {
                "type": "string",
                "maxLength": 120
              },
              "canApprove": {
                "type": "boolean"
              },
              "online": {
                "type": "boolean"
              },
              "connections": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pairedAt": {
                "type": "number"
              },
              "lastSeen": {
                "type": "number"
              }
            },
            "required": [
              "deviceId",
              "name",
              "kind",
              "role",
              "capabilities",
              "canApprove",
              "online",
              "connections",
              "pairedAt"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string",
          "enum": [
            "join",
            "leave",
            "update",
            "paired",
            "revoked"
          ]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "spaceId",
        "devices"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
