{
  "title": "control.event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "control.event"
    },
    "payload": {
      "type": "object",
      "properties": {
        "widgetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ts": {
          "type": "number"
        },
        "specId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "phase": {
          "type": "string",
          "enum": [
            "start",
            "move",
            "end"
          ]
        }
      },
      "required": [
        "widgetId",
        "value",
        "ts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
