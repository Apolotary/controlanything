{
  "title": "device.card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "device.card"
    },
    "payload": {
      "type": "object",
      "properties": {
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "maker": {
          "type": "string",
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "synthesizer",
            "drum-machine",
            "sampler",
            "groovebox",
            "midi-controller",
            "audio-interface",
            "effects",
            "lighting",
            "remote-control",
            "appliance",
            "computer",
            "microcontroller",
            "phone",
            "other"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "protocols": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "midi",
              "ble",
              "serial",
              "ir",
              "http",
              "osc",
              "hid",
              "other"
            ]
          }
        },
        "evidence": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "alternatives": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "maker": {
                "type": "string",
                "maxLength": 120
              },
              "model": {
                "type": "string",
                "maxLength": 120
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "maker",
              "model",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "visibleText": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "companion": {
          "type": "string",
          "enum": [
            "none",
            "computer_usb",
            "ir_blaster",
            "phone_ble",
            "network"
          ]
        },
        "followUp": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "requires": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "midi",
              "serial",
              "ble",
              "ir",
              "camera",
              "mic",
              "hands",
              "display",
              "speaker",
              "gpio",
              "wifi",
              "local",
              "printer"
            ]
          }
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "detId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bbox": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        },
        "modelId": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "cardId",
        "name",
        "maker",
        "model",
        "category",
        "confidence",
        "protocols",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
