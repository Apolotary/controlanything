{
  "title": "hello",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "hello"
    },
    "payload": {
      "type": "object",
      "properties": {
        "executor": {
          "type": "boolean"
        },
        "deviceToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "enum": [
            "hmd",
            "companion",
            "controller",
            "device"
          ]
        },
        "capabilities": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "midi",
              "serial",
              "ble",
              "ir",
              "camera",
              "mic",
              "hands",
              "display",
              "speaker",
              "gpio",
              "wifi",
              "local",
              "printer"
            ]
          }
        },
        "ports": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "enum": [
                  "midi-in",
                  "midi-out",
                  "serial",
                  "ble",
                  "ir",
                  "usb"
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "manufacturer": {
                "type": "string",
                "maxLength": 256
              },
              "state": {
                "type": "string",
                "enum": [
                  "connected",
                  "disconnected"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "app": {
          "type": "string",
          "maxLength": 120
        },
        "foreground": {
          "type": "boolean"
        }
      },
      "required": [
        "deviceToken"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
