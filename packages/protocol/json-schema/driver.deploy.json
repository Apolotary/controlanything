{
  "title": "driver.deploy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "driver.deploy"
    },
    "payload": {
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime": {
          "type": "string",
          "enum": [
            "browser-js",
            "node",
            "micropython",
            "arduino",
            "other"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "javascript",
            "typescript",
            "python",
            "cpp",
            "other"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 500000
        },
        "entry": {
          "type": "string",
          "maxLength": 120
        },
        "actions": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "driverId",
        "version",
        "runtime",
        "language",
        "code",
        "actions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
