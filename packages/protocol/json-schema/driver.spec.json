{
  "title": "driver.spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "driver.spec"
    },
    "payload": {
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "transport": {
          "type": "string",
          "enum": [
            "midi",
            "ir",
            "local",
            "ble"
          ]
        },
        "executor": {
          "type": "object",
          "properties": {
            "deviceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "port": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "deviceId"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "midi.guide",
                  "manual",
                  "irdb",
                  "web_search",
                  "learned",
                  "curated",
                  "fixture"
                ]
              },
              "ref": {
                "type": "string",
                "maxLength": 500
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "source",
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "kind": {
                "type": "string",
                "enum": [
                  "set",
                  "trigger",
                  "toggle"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "range": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "curve": {
                "type": "string",
                "enum": [
                  "linear",
                  "exponential",
                  "step"
                ]
              },
              "encode": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "midi"
                      },
                      "msg": {
                        "type": "string",
                        "enum": [
                          "cc",
                          "note",
                          "pc",
                          "sysex-identity",
                          "panic"
                        ]
                      },
                      "channel": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      },
                      "number": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 127
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 127
                          },
                          {
                            "type": "string",
                            "const": "$value"
                          }
                        ]
                      },
                      "velocity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 127
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    },
                    "required": [
                      "kind",
                      "msg",
                      "channel"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "ir"
                      },
                      "protocol": {
                        "type": "string",
                        "enum": [
                          "NEC",
                          "AEHA",
                          "SONY",
                          "RC5",
                          "RC6",
                          "KASEIKYO",
                          "RAW"
                        ]
                      },
                      "bytes": {
                        "maxItems": 16,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "address": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "command": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "unitUs": {
                        "type": "number",
                        "minimum": 200,
                        "maximum": 1000
                      },
                      "repeats": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "frameGapUs": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 500000
                      },
                      "rawUs": {
                        "minItems": 2,
                        "maxItems": 1024,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65000
                        }
                      },
                      "khz": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 60
                      },
                      "ref": {
                        "type": "string",
                        "maxLength": 120
                      }
                    },
                    "required": [
                      "kind",
                      "protocol"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "local"
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "volume",
                          "music",
                          "say",
                          "torch",
                          "haptic",
                          "print",
                          "screen",
                          "beep"
                        ]
                      },
                      "arg": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 2000
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "string",
                            "const": "$value"
                          },
                          {
                            "type": "object",
                            "additionalProperties": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 2000
                                },
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                },
                                {
                                  "maxItems": 32,
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "maxLength": 256
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "op"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "ble"
                      },
                      "profile": {
                        "type": "string",
                        "enum": [
                          "dji-osmo"
                        ]
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "pan",
                          "tilt",
                          "nudge",
                          "recenter",
                          "stop"
                        ]
                      },
                      "arg": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "string",
                            "const": "$value"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "yaw": {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                              },
                              "pitch": {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                              },
                              "durationMs": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 10000
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "profile",
                      "op"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "step"
                      },
                      "upActionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "downActionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "steps": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 64
                      },
                      "settleMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      }
                    },
                    "required": [
                      "kind",
                      "upActionId",
                      "downActionId",
                      "steps"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "expect": {
                "type": "object",
                "properties": {
                  "sense": {
                    "type": "string",
                    "enum": [
                      "camera",
                      "audio",
                      "ack",
                      "none"
                    ]
                  },
                  "effect": {
                    "type": "string",
                    "enum": [
                      "on",
                      "off",
                      "brighter",
                      "dimmer",
                      "warmer",
                      "cooler",
                      "louder",
                      "quieter",
                      "tone-up",
                      "tone-down",
                      "any",
                      "none"
                    ]
                  }
                },
                "required": [
                  "sense",
                  "effect"
                ],
                "additionalProperties": false
              },
              "inverseActionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "confirm": {
                "type": "string",
                "enum": [
                  "tap",
                  "hold"
                ]
              },
              "verified": {
                "type": "string",
                "enum": [
                  "pending",
                  "pass",
                  "fail",
                  "untested"
                ]
              }
            },
            "required": [
              "actionId",
              "label",
              "kind",
              "encode"
            ],
            "additionalProperties": false
          }
        },
        "maxRateHz": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "modelId": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "driverId",
        "cardId",
        "transport",
        "executor",
        "provenance",
        "actions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
