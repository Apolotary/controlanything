{
  "title": "project.state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "project.state"
    },
    "payload": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "generating",
            "ready",
            "error"
          ]
        },
        "document": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cardId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "spec": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "maxLength": 400
                },
                "html": {
                  "type": "string",
                  "maxLength": 60000
                },
                "css": {
                  "type": "string",
                  "maxLength": 30000
                },
                "js": {
                  "type": "string",
                  "maxLength": 60000
                },
                "actions": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 48,
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "number",
                          "trigger"
                        ]
                      },
                      "min": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "max": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "initial": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                },
                "spatial": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "orb",
                        "ripples"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "actionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48,
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "color",
                    "actionId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "description",
                "html",
                "css",
                "js",
                "actions"
              ],
              "additionalProperties": false
            },
            "source": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "live",
                    "fixture"
                  ]
                },
                {
                  "type": "string",
                  "const": "preset"
                }
              ]
            },
            "presetId": {
              "type": "string",
              "const": "chord-garden-v1"
            },
            "modelId": {
              "type": "string",
              "maxLength": 120
            },
            "createdAt": {
              "type": "number"
            }
          },
          "required": [
            "projectId",
            "revision",
            "prompt",
            "spec",
            "source",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string",
          "maxLength": 600
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "preview": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "projectId",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
