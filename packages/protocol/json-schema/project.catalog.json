      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "project.catalog"
    },
    "payload": {
      "type": "object",
      "properties": {
        "projects": {
          "maxItems": 32,
          "type": "array",
          "items": {
