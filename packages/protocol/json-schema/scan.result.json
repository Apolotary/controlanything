{
  "title": "scan.result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "scan.result"
    },
    "payload": {
      "type": "object",
      "properties": {
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "detections": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "detId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "prompt": {
                "type": "string",
                "maxLength": 60
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "box": {
                "minItems": 4,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "polygon": {
                "minItems": 3,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "minItems": 2,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              },
              "cardId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "trackId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "detId",
              "label",
              "prompt",
              "score",
              "box"
            ],
            "additionalProperties": false
          }
        },
        "qr": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 512
              },
              "pairingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "approved": {
                "type": "boolean"
              },
              "box": {
                "minItems": 4,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "modelId": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "prompts": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "required": [
        "frameId",
        "width",
        "height",
        "detections",
        "modelId",
        "source",
        "latencyMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
