{
  "title": "ui.spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "ui.spec"
    },
    "payload": {
      "type": "object",
      "properties": {
        "specId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "widgets": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "kind": {
                "type": "string",
                "enum": [
                  "knob",
                  "fader",
                  "button",
                  "toggle",
                  "xy",
                  "pads"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "range": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "yRange": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "default": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 16
              },
              "binding": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "driverId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "channel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "cc": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "note": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "required": [
                  "action"
                ],
                "additionalProperties": false
              },
              "yBinding": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "driverId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "channel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "cc": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "note": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "required": [
                  "action"
                ],
                "additionalProperties": false
              },
              "pads": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "note": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    },
                    "color": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "additionalProperties": false
                }
              },
              "layout": {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  "col": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  "span": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "size": {
                    "type": "string",
                    "enum": [
                      "s",
                      "m",
                      "l"
                    ]
                  },
                  "color": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "panel",
                      "device",
                      "hand"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "binding"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        }
      },
      "required": [
        "specId",
        "title",
        "widgets"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
