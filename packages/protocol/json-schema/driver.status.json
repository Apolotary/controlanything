{
  "title": "driver.status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "driver.status"
    },
    "payload": {
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "phase": {
          "type": "string",
          "enum": [
            "drafting",
            "validating",
            "verifying",
            "verified",
            "armed",
            "disarmed",
            "failed"
          ]
        },
        "actions": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "verified": {
                "type": "string",
                "enum": [
                  "pending",
                  "pass",
                  "fail",
                  "untested"
                ]
              }
            },
            "required": [
              "actionId",
              "verified"
            ],
            "additionalProperties": false
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "loading",
            "running",
            "stopped",
            "error"
          ]
        },
        "modelId": {
          "type": "string",
          "maxLength": 120
        },
        "detail": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "driverId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
