{
  "title": "agent.step",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "agent.step"
    },
    "payload": {
      "type": "object",
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "phase": {
          "type": "string",
          "enum": [
            "capture",
            "identify",
            "research",
            "plan",
            "codegen",
            "verify",
            "deploy",
            "ui",
            "control",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "ok",
            "fail"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "maxLength": 4000
        },
        "model": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        },
        "startedAt": {
          "type": "number"
        },
        "endedAt": {
          "type": "number"
        }
      },
      "required": [
        "stepId",
        "phase",
        "status",
        "title"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
