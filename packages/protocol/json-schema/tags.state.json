{
  "title": "tags.state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "tags.state"
    },
    "payload": {
      "type": "object",
      "properties": {
        "tags": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identityRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "placement": {
                "type": "object",
                "properties": {
                  "headsetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "origin": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "panelOffset": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "additionalProperties": false
                  },
                  "fallback": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "appearance": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  "updatedAt": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "headsetId",
                  "origin",
                  "panelOffset",
                  "fallback",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              "cardId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "category": {
                "type": "string",
                "maxLength": 60
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "connection": {
                "type": "string",
                "enum": [
                  "ready",
                  "setup",
                  "offline"
                ]
              },
              "hint": {
                "type": "string",
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "enum": [
                  "retry",
                  "cancel",
                  "open-companion",
                  "pair-device"
                ]
              },
              "specId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "cardId",
              "label",
              "connection"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
