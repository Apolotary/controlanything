{
  "title": "log",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "type": "number"
    },
    "from": {
      "type": "string",
      "maxLength": 128
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "const": "log"
    },
    "payload": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "ref": {
          "type": "string",
          "maxLength": 128
        },
        "issues": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "required": [
        "level",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
