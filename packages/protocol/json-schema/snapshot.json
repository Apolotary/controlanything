                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false
            },
            "orientation": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z",
                "w"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "position",
            "orientation"
          ],
          "additionalProperties": false
        },
        "cameraPose": {
          "type": "object",
          "properties": {
            "position": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false
            },
            "orientation": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z",
                "w"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "position",
            "orientation"
          ],
          "additionalProperties": false
