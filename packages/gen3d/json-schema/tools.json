                "maximum": 1
              },
              "rTop": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rBottom": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rInner": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rOuter": {
                "type": "number",
                "minimum": 0.0005,
                "maximum": 1
              },
              "tube": {
                "type": "number",
