[
  {
    "type": "function",
    "function": {
      "name": "set_meta",
      "description": "Set the object title, the physical device it controls, where it is anchored (device/floating/surface/hand/world) and whether it is armed. Call first.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "device": {
            "type": "object",
            "properties": {
              "cardId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "category": {
                "type": "string",
                "maxLength": 32
              },
              "accents": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "transport": {
                "type": "string",
                "enum": [
                  "usb-midi",
                  "ble-midi",
                  "ir",
                  "serial",
                  "http",
                  "sim",
                  "other"
                ]
              }
            },
            "required": [
              "name"
            ]
          },
          "anchor": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "device",
                  "floating",
                  "surface",
                  "hand",
                  "world"
                ]
              },
              "cardId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "side": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "above",
                  "front",
                  "behind"
                ]
              },
              "offset": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "distance": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 3
              },
              "pitchDeg": {
                "type": "number",
                "minimum": -60,
                "maximum": 60
              },
              "position": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "rotationDeg": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "hand": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "faceUser": {
                "type": "boolean"
              },
              "grabbable": {
                "type": "boolean"
              }
            },
            "required": [
              "mode"
            ]
          },
          "state": {
            "type": "object",
            "properties": {
              "armed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 80
              },
              "verifiedBy": {
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            },
            "required": [
              "armed"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 400
          }
        }
      },
      "strict": false
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_control",
      "description": "Add or replace one semantic control: kind (continuous/stepped/toggle/trigger/xy), label, range, default and the driver binding (midi.cc, ir.send, sim.*, or a generated driver action). Every control needs an archetype part or a behaviour that operates it.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "continuous",
              "stepped",
              "toggle",
              "trigger",
              "xy"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "range": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "min",
              "max"
            ]
          },
          "yRange": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "min",
              "max"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 8
          },
          "default": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            ]
          },
          "stepLabels": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 12
            }
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "binding": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "driverId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "cc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "note": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            },
            "required": [
              "action"
            ]
          },
          "yBinding": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "driverId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "cc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "note": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            },
            "required": [
              "action"
            ]
          },
          "armed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "binding"
        ]
      },
      "strict": false
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_part",
      "description": "Add or replace one 3D part. Prefer kind \"archetype\" (knob, fader, lever, button, toggle, dimmer-ring, pull-cord, xy-orb, pads, keys, wheel, hack-list, tag, outline, brackets, ping-line, link-matrix, upload-bar, daemon-link, worklog, model-chips...) with controlId and params; use kind \"primitive\"/\"text\"/\"path\" with parentId to compose novel objects. Positions in metres, +x right, +y up, +z toward the user.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "parentId": {
