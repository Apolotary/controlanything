                "type": "string",
                "enum": [
                  "solid",
                  "dashed",
                  "dotted",
                  "dash-dot",
                  "cone"
                ]
              },
              "animate": {
                "type": "string",
                "enum": [
                  "none",
                  "flow",
                  "pulse"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "particles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "speed": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 5
              }
            }
          },
          "transform": {
            "type": "object",
            "properties": {
              "position": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "rotationDeg": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "scale": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10
                  },
                  {
                    "minItems": 3,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            }
          },
          "material": {
            "type": "object",
            "properties": {
              "style": {
                "type": "string",
                "enum": [
                  "solid",
                  "holo",
                  "wire",
                  "glass",
                  "glitch"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "emissive": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "emissiveIntensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "metalness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "opacity": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 1
              },
              "glow": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "fresnel": {
                "type": "number",
                "minimum": 0,
                "maximum": 6
              },
              "scanlines": {
                "type": "boolean"
              },
              "flicker": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "edges": {
                "type": "boolean"
              },
              "edgeColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "textureUrl": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "visibleWhen": {
            "type": "string",
            "enum": [
              "always",
              "armed",
              "disarmed",
              "hover",
              "grabbed",
              "never"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ]
      },
      "strict": false
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_behavior",
      "description": "Attach an affordance to a composed part: rotate/slide/press/toggle/pull/xy/grab, with axis, sweepDeg or travel, gestures and detents. Archetypes already include their behaviours.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "partId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "controlId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "rotate",
              "slide",
              "press",
              "toggle",
              "pull",
              "xy",
              "grab"
            ]
          },
          "axis": {
            "type": "string",
            "enum": [
              "x",
              "y",
              "z"
            ]
          },
          "plane": {
            "type": "string",
            "enum": [
              "xy",
              "xz",
              "yz"
            ]
          },
          "sweepDeg": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "travel": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "depth": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 0.1
          },
          "gestures": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pinch-drag",
                "pinch-twist",
                "poke",
                "grab",
                "pinch"
              ]
            }
          },
          "dragGain": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 2
          },
          "detents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "spring": {
            "type": "boolean"
          },
          "invert": {
            "type": "boolean"
          },
          "grabRadius": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.5
          }
        },
        "required": [
          "id",
          "partId",
          "type"
        ]
      },
      "strict": false
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_feedback",
      "description": "Attach feedback to a control: glow, arc-fill, readout, tick (sound), particles, beam-pulse, scale-pop, color-shift, glitch; optionally on a specific part.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "controlId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "glow",
              "arc-fill",
              "readout",
              "tick",
              "particles",
              "beam-pulse",
              "scale-pop",
              "color-shift",
              "glitch"
            ]
          },
          "partId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "format": {
            "type": "string",
            "maxLength": 24
          },
          "every": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1
          },
          "sound": {
            "type": "string",
            "enum": [
              "tick",
              "click",
              "pluck",
              "knock",
              "chirp",
              "none"
            ]
          },
          "on": {
            "type": "string",
            "enum": [
              "change",
              "hover",
              "grab",
              "release",
              "arm",
              "trigger"
            ]
          }
        },
        "required": [
          "id",
          "controlId",
          "type"
        ]
      },
      "strict": false
    }
  },
  {
    "type": "function",
    "function": {
      "name": "remove_item",
      "description": "Remove a control, part (with its subtree), behaviour or feedback by id.",
      "parameters": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "enum": [
              "controls",
              "parts",
              "behaviors",
              "feedback"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "collection",
          "id"
        ]
      },
      "strict": false
    }
  },
  {
    "type": "function",
    "function": {
      "name": "finish",
      "description": "Declare the object complete. The server validates it and renders it.",
      "parameters": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "strict": false
    }
  }
]
