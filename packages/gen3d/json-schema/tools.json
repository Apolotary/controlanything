            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "group",
              "primitive",
              "archetype",
              "text",
              "path"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "role": {
            "type": "string",
