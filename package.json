{
  "name": "controleverything",
  "private": true,
  "version": "0.1.0",
  "description": "ControlAnything: control the devices and software around you from a Meta Quest 3, with Meta's SAM and Muse models.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -i --default-input-target server -n server,companion,quest -c blue,green,magenta \"npm run dev -w @ce/server\" \"npm run dev -w @ce/companion\" \"npm run dev -w @ce/quest\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run start -w @ce/server",
    "smoke": "npm run smoke -w @ce/server",
    "demo:sim": "tsx apps/sim/scripts/demo-sim.ts",
    "e2e:judge": "node scripts/e2e-judge.mjs",
    "e2e:vsynth": "node scripts/e2e-vsynth.mjs",
    "e2e:projects": "node scripts/e2e-projects.mjs",
    "e2e:chords": "node scripts/e2e-chords.mjs",
    "e2e:synth-launch": "node scripts/e2e-synth-launch.mjs",
    "e2e:tracking": "node scripts/e2e-tracking.mjs",
    "quest:live": "node scripts/quest-live.mjs",
    "test:quest-live": "node --test scripts/lib/mjpeg.test.mjs scripts/lib/quest-live.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
